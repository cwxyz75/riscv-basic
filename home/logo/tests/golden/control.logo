repeat 3 [print "hi]
repeat 2 [repeat 2 [type "x] print "!]
if 1 = 1 [print "yes]
if 1 = 2 [print "yes]
ifelse 1 = 2 [print "a] [print "b]
ifelse 1 = 1 [print "a] [print "b]
run [print 1 print 2]
make "cmd [print "ran]
run :cmd
make "n 0
repeat 5 [make "n :n + 2]
print :n
repeat 0 [print "never]
to firstbig
repeat 10 [if 5 < 10 [output "found]]
print "after
end
print firstbig
to early
repeat 5 [print "x stop]
print "no
end
early
wait 1
run [fd -0 print 3 - 2]
