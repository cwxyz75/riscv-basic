 /// Add `[a, b)` to a sorted list, merging with the last range when they touch or overlap.
 fn push(out: &mut Vec<(u64, u64)>, a: u64, b: u64) {
     match out.last_mut() {
         Some(last) if a <= last.1 => last.1 = last.1.max(b),
         _ => out.push((a, b)),
     }
