10 REM 99 BOTTLES OF BEER
20 FOR N=99 TO 1 STEP -1
30 K=N: GOSUB 200: PRINT B$;" OF BEER ON THE WALL, ";B$;" OF BEER."
40 K=N-1: PRINT "TAKE ONE DOWN AND PASS IT AROUND, ";: GOSUB 200: PRINT B$;" OF BEER ON THE WALL."
50 PRINT
60 NEXT N
70 END
200 REM B$ BECOMES "N BOTTLES", "1 BOTTLE" OR "NO MORE BOTTLES" FOR K
210 IF K=0 THEN B$="NO MORE BOTTLES": RETURN
220 B$=MID$(STR$(K),2)+" BOTTLE"
230 IF K>1 THEN B$=B$+"S"
240 RETURN
