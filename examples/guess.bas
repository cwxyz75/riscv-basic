10 REM GUESS THE NUMBER
20 PRINT "I AM THINKING OF A NUMBER FROM 1 TO 100."
25 X=RND(-TIMER)
30 N=INT(RND(1)*100)+1
40 T=0
50 INPUT "YOUR GUESS";G
60 T=T+1
70 IF G<N THEN PRINT "TOO LOW": GOTO 50
80 IF G>N THEN PRINT "TOO HIGH": GOTO 50
90 PRINT "YOU GOT IT IN";STR$(T);" GUESSES!"
100 IF T<=7 THEN PRINT "NICE WORK."
110 IF T>7 THEN PRINT "TRY HALVING THE RANGE EACH TIME."
